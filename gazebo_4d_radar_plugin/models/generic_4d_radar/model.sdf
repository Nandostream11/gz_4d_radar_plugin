<?xml version="1.0"?>
<sdf version="1.9">
  <model name="generic_4d_radar">
    <static>false</static>
    <link name="radar_link">
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003</ixx>
          <iyy>0.0003</iyy>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.10 0.08 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.15 1.0</ambient>
          <diffuse>0.2 0.2 0.25 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.10 0.08 0.03</size>
          </box>
        </geometry>
      </collision>

      <!-- Generic 4D Radar System Plugin -->
      <plugin
        filename="libgazebo_4d_radar_plugin.so"
        name="gazebo_4d_radar_plugin::Gazebo4DRadarPlugin">
        <sensor_name>radar</sensor_name>
        <frame_id>radar_link</frame_id>
        <radar_profile>generic</radar_profile>
        <scan_topic>/radar/scan</scan_topic>
        <pointcloud_topic>/radar/points</pointcloud_topic>
        <publish_radar_scan>true</publish_radar_scan>
        <publish_pointcloud>true</publish_pointcloud>

        <!-- Carrier & Update Rate -->
        <cycle_rate_hz>20.0</cycle_rate_hz>

        <!-- FOV and Range -->
        <max_range_m>200.0</max_range_m>
        <min_range_m>0.2</min_range_m>
        <fov_azimuth_rad>2.0944</fov_azimuth_rad>   <!-- 120 deg (-60 to +60) -->
        <fov_elevation_rad>0.5236</fov_elevation_rad> <!-- 30 deg (-15 to +15) -->

        <!-- Doppler Kinematics & Folding -->
        <v_max_mps>50.0</v_max_mps>
        <enable_doppler_folding>true</enable_doppler_folding>
        <closing_velocity_positive>false</closing_velocity_positive>

        <!-- Noise Standard Deviations -->
        <range_sigma_m>0.05</range_sigma_m>
        <azimuth_sigma_rad>0.0052</azimuth_sigma_rad>
        <elevation_sigma_rad>0.0105</elevation_sigma_rad>
        <range_rate_sigma_mps>0.05</range_rate_sigma_mps>

        <!-- Reporting Resolutions -->
        <range_resolution_m>0.02</range_resolution_m>
        <azimuth_resolution_rad>0.00175</azimuth_resolution_rad>
        <elevation_resolution_rad>0.00349</elevation_resolution_rad>
        <range_rate_resolution_mps>0.01</range_rate_resolution_mps>

        <!-- Clutter & Noise Non-Idealities -->
        <false_detection_rate_per_cycle>2.0</false_detection_rate_per_cycle>
        <detection_dropout_probability>0.03</detection_dropout_probability>
        <min_rcs_threshold>-25.0</min_rcs_threshold>

        <!-- Ray Grid Density -->
        <ray_samples_azimuth>120</ray_samples_azimuth>
        <ray_samples_elevation>30</ray_samples_elevation>
      </plugin>
    </link>
  </model>
</sdf>
